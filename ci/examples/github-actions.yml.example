# OPCIONAL — ejemplo GitHub Actions. NO obligas a usar GitHub.
# Copia a .github/workflows/gates.yml y bórrale el .example si lo usas.
name: Gates
on: [push, pull_request]
permissions: { contents: read }
jobs:
  gates:
    runs-on: ubuntu-latest   # <!-- FILL: macos-latest si compilas iOS -->
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }   # historial completo para gitleaks
      - name: Install gitleaks
        run: |
          curl -sSL https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_linux_x64.tar.gz \
            | tar -xz -C /usr/local/bin gitleaks
      - name: Run gates
        run: bash ci/run-gates.sh
        env:
          GATES_SECRET_MODE: history
