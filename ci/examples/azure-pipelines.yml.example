# OPCIONAL — ejemplo Azure Pipelines. Copia a azure-pipelines.yml.
trigger: [main, develop]
pool: { vmImage: ubuntu-latest }
steps:
  - checkout: self
    fetchDepth: 0   # historial completo para gitleaks
  - script: |
      curl -sSL https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_linux_x64.tar.gz | tar -xz -C /usr/local/bin gitleaks
      bash ci/run-gates.sh
    displayName: Run gates
    env: { GATES_SECRET_MODE: history }
