# OPCIONAL — ejemplo Bitbucket Pipelines. Copia a bitbucket-pipelines.yml.
image: atlassian/default-image:4
pipelines:
  default:
    - step:
        name: Gates
        clone: { depth: full }   # historial completo para gitleaks
        script:
          - curl -sSL https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_linux_x64.tar.gz | tar -xz -C /usr/local/bin gitleaks
          - bash ci/run-gates.sh
