{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Anillo 2 (Claude Code). Wrapper delgado: mapea eventos de Claude a los scripts COMPARTIDOS en scripts/agent-hooks/. La lógica vive una sola vez; Cursor usa los mismos scripts vía .cursor/hooks.json.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash scripts/agent-hooks/session-start.sh", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash scripts/agent-hooks/skill-reminder.sh", "timeout": 5 }] },
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash scripts/agent-hooks/reviewer-gate.sh", "timeout": 20 }] }
    ],
    "PostToolUse": [
      { "matcher": "Read",
        "hooks": [{ "type": "command", "command": "bash scripts/agent-hooks/track-reads.sh", "timeout": 3 }] },
      { "matcher": "Read|Edit|Write|MultiEdit|Bash|Grep|Glob|Task|WebFetch|WebSearch|mcp__.*",
        "hooks": [{ "type": "command", "command": "bash scripts/agent-hooks/track-trajectory.sh", "timeout": 3 }] }
    ],
    "Stop": [
      { "hooks": [
          { "type": "command", "command": "bash scripts/agent-hooks/canon-enforce.sh", "timeout": 10 },
          { "type": "command", "command": "bash scripts/agent-hooks/drift-stop.sh", "timeout": 30 }
      ] }
    ]
  }
}
